# Tema de arranque de ElaOS — logo centrado sobre fondo oscuro (estilo macOS).

# Fondo oscuro casi negro
Window.SetBackgroundTopColor(0.07, 0.07, 0.09);
Window.SetBackgroundBottomColor(0.07, 0.07, 0.09);

# Logo (variante de texto claro: logo.png)
logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 0);

# --- Mensajes de estado del arranque ---
message_sprite = Sprite();
fun message_callback(text) {
    img = Image.Text(text, 0.8, 0.8, 0.8);
    message_sprite.SetImage(img);
    message_sprite.SetPosition(
        Window.GetWidth() / 2 - img.GetWidth() / 2,
        logo.y + logo.image.GetHeight() + 40, 1);
}
Plymouth.SetMessageFunction(message_callback);

# --- Prompt de contraseña (para disco cifrado LUKS) ---
fun display_password_callback(prompt, bullets) {
    stars = "";
    for (i = 0; i < bullets; i++) stars += "*";
    img = Image.Text(prompt + "   " + stars, 1, 1, 1);
    message_sprite.SetImage(img);
    message_sprite.SetPosition(
        Window.GetWidth() / 2 - img.GetWidth() / 2,
        logo.y + logo.image.GetHeight() + 40, 1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
