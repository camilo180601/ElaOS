# Apariencia por defecto de ElaOS (estilo macOS)
[org/gnome/desktop/interface]
gtk-theme='WhiteSur-Light'
icon-theme='WhiteSur'
cursor-theme='McMojave-cursors'
font-name='Inter 11'
monospace-font-name='Fira Code 11'
color-scheme='default'
enable-hot-corners=true

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'elaos-modes@elaos']
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'kitty.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Settings.desktop']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dash-max-icon-size=48
running-indicator-style='DOTS'
transparency-mode='DYNAMIC'
show-trash=false
click-action='minimize'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/elaos/elaos-gradient.png'
picture-uri-dark='file:///usr/share/backgrounds/elaos/elaos-dark-logo.png'
picture-options='zoom'

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
