#!/bin/sh
# Instala la capa visual estilo macOS Big Sur dentro del sistema vivo.
# Resiliente: un fallo de descarga NO aborta el build (deja warning y sigue).
# Verboso: los clones reintentan y muestran el error real de git si falla.

log() { echo "[ElaOS] $*"; }

# clone <url> <dir> — hasta 3 intentos, muestra el error de git
clone() {
    _url="$1"; _dir="$2"
    i=1
    while [ "$i" -le 3 ]; do
        rm -rf "$_dir"
        if git clone --depth=1 "$_url" "$_dir"; then
            return 0
        fi
        log "AVISO: clone de $_url falló (intento $i/3), reintento..."
        i=$((i + 1))
        sleep 3
    done
    log "ERROR: no se pudo clonar $_url tras 3 intentos."
    return 1
}

TMP="/tmp/elaos-theme"
rm -rf "$TMP"; mkdir -p "$TMP"; cd "$TMP" || exit 0

log "Instalando tema GTK WhiteSur..."
if clone https://github.com/vinceliuice/WhiteSur-gtk-theme.git WhiteSur-gtk-theme; then
    # Sin -l (libadwaita): toca gsettings/GTK4 y falla en el chroot.
    # bash -x deja la traza por si algo más rompe.
    ( cd WhiteSur-gtk-theme && HOME=/root bash -x ./install.sh -d /usr/share/themes -c Light -c Dark ) \
        > /tmp/whitesur-gtk.log 2>&1
    rc=$?
    if [ "$rc" -eq 0 ]; then
        log "WhiteSur-gtk instalado correctamente."
    else
        log "AVISO: WhiteSur-gtk falló (rc=$rc). Traza (últimas 30 líneas):"
        tail -30 /tmp/whitesur-gtk.log
    fi
fi

log "Instalando iconos WhiteSur..."
if clone https://github.com/vinceliuice/WhiteSur-icon-theme.git WhiteSur-icon-theme; then
    ( cd WhiteSur-icon-theme && ./install.sh -d /usr/share/icons ) \
        || log "AVISO: install.sh de iconos falló."
fi

log "Instalando cursores McMojave..."
if clone https://github.com/vinceliuice/McMojave-cursors.git McMojave-cursors; then
    ( cd McMojave-cursors && ./install.sh ) || log "AVISO: install.sh de cursores falló."
fi

log "Instalando Dash to Dock (dock inferior)..."
if clone https://github.com/micheleg/dash-to-dock.git dash-to-dock; then
    ( cd dash-to-dock && make install ) || log "AVISO: Dash to Dock no compiló."
fi

log "Instalando wallpaper por defecto..."
if clone https://github.com/vinceliuice/WhiteSur-wallpapers.git WhiteSur-wallpapers; then
    mkdir -p /usr/share/backgrounds/elaos
    WP="$(find WhiteSur-wallpapers -type f \( -name '*.jpg' -o -name '*.png' \) | head -n1)"
    [ -n "$WP" ] && cp "$WP" /usr/share/backgrounds/elaos/default.jpg
fi

log "Aplicando tema de login (GDM) estilo macOS..."
if [ -d WhiteSur-gtk-theme ]; then
    ( cd WhiteSur-gtk-theme && ./tweaks.sh -g -b /usr/share/backgrounds/elaos/default.jpg ) \
        || log "AVISO: no se pudo aplicar el tema de GDM."
fi

log "Compilando base de datos dconf..."
dconf update || true

cd /
rm -rf "$TMP"
log "Capa visual macOS procesada."
exit 0
